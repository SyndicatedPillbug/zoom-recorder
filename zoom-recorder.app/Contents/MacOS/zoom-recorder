#!/bin/bash
# zoom-recorder.app launcher (menu-bar app).
#
# The menu-bar app runs under launchd, which gives it no TCC identity of its
# own (bare python3 = com.apple.python3, which never shows a permission
# prompt). Running the python child from inside this .app bundle gives macOS
# a real app to attach audio/screen permissions to, and the app appears by
# name in System Settings > Privacy & Security.
#
# No `exec`: the .app binary must stay alive as the parent, otherwise the
# process identity reverts to com.apple.python3.
set -euo pipefail

# .app/Contents/MacOS -> .app/Contents -> .app -> repo root
SCRIPT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

/usr/bin/python3 "$SCRIPT_DIR/menubar.py"
